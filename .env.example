# Sao chép thành .env.local khi chạy thử, hoặc đặt trong GitHub Secrets/Variables khi deploy
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.vn
# ID form tạo tại https://formspree.io (phần sau /f/ trong URL form). Để trống = form mở email.
NEXT_PUBLIC_FORMSPREE_ID=
# Khoá Google Maps cho tính km tự động (xem README)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
